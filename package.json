{
  "name": "akarisub",
  "version": "1.0.1",
  "description": "libass Subtitle Renderer and Parser library for browsers",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pkg": {
      "import": "./pkg/akarisub.js",
      "default": "./pkg/akarisub.js"
    }
  },
  "files": [
    "dist",
    "pkg",
    "src/wrapper.ts",
    "assets",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:wasm": "make worker",
    "build:ts": "tsc",
    "build": "bun run license:third-party && bun run build:wasm && bun run build:ts",
    "license:third-party": "bun build/generate-third-party-notices.mjs",
    "clean": "rm -rf pkg dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test ./tests",
    "format": "bun run prettier . --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altqx/akarisub.git"
  },
  "keywords": [
    "libass",
    "subtitle",
    "wasm",
    "emscripten"
  ],
  "author": "altqx",
  "contributors": [
    "ThaUnknown",
    "SubtitlesOctopus Contributors"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/altqx/akarisub/issues"
  },
  "homepage": "https://github.com/altqx/akarisub",
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/emscripten": "^1.41.5",
    "@webgpu/types": "^0.1.71",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
